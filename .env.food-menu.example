# 情侣点餐模块 — 微信公众号推送配置
# 复制到项目根目录 .env，以及 Vercel → Settings → Environment Variables

# --- 微信公众号（服务号/订阅号均可，需已认证才能用模板消息）---
# 登录 https://mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=

# 接收「女朋友点餐通知」的用户 openid（男朋友的公众号 openid）
# 获取方式：公众号后台 → 用户管理 → 点开用户，或通过网页授权 snsapi_base 拿到
# 多个接收人用英文逗号分隔
WECHAT_MP_OPENID=

# 推送方式：custom = 客服文本消息（默认，文案与需求模板完全一致）
#           template = 模板消息（更可靠，不受 48 小时互动限制，需先申请模板）
# 注意：客服消息要求该用户近 48 小时内与公众号有过互动，否则微信会返回 45015
WECHAT_MP_MSG_TYPE=custom

# 仅当 WECHAT_MP_MSG_TYPE=template 时需要填写
# 公众号后台 → 广告与服务 → 模板消息，申请后拿到 template_id
WECHAT_MP_TEMPLATE_ID=

# 模板字段名（旧版 first/keyword1/keyword2/keyword3/remark；新版如 time2/thing5/thing8）
# 不填则按旧版 keyword 结构发送
WECHAT_MP_TPL_TIME_KEY=keyword1
WECHAT_MP_TPL_LIST_KEY=keyword2
WECHAT_MP_TPL_REMARK_KEY=keyword3
